@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix mce:  <http://example.org/dce#> .
<#EnergyConsumptionMap> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "mec03_clean.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "http://example.org/dce#consumption/{year_id}/{county_id}/{sector_id}" ;
    rr:class mce:Consumption
  ] ;
  rr:predicateObjectMap [
    rr:predicate mce:inPeriod ;
    rr:objectMap [ rr:template "http://example.org/dce#year/{year_id}" ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate mce:value ;
    rr:objectMap [ rml:reference "value" ; rr:datatype xsd:float ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate mce:unit ;
    rr:objectMap [ rml:reference "unit" ; rr:datatype xsd:string ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate mce:sector ;
    rr:objectMap [ rml:reference "sector" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate mce:locatedIn ;
  rr:objectMap [ rr:template "http://example.org/dce#county/{county_id}" ]
] .
