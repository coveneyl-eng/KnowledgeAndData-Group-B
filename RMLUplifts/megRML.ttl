@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix mce:  <http://example.org/dce#> .
<#EnergyProductionMap> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "meg02_clean.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "http://example.org/dce#production/{month_id}/{fuel_id}" ;
    rr:class mce:Production
  ] ;
  rr:predicateObjectMap [
    rr:predicate mce:inPeriod ;
    rr:objectMap [ rr:template "http://example.org/dce#month/{month_id}" ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate mce:value ;
    rr:objectMap [ rml:reference "value" ; rr:datatype xsd:float ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate mce:unit ;
    rr:objectMap [ rml:reference "unit" ; rr:datatype xsd:string ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate mce:hasFuelSource ;
  rr:objectMap [ rr:template "http://example.org/dce#fuelSource/{fuel_id}" ]
] .
