@prefix dce: <http://example.org/dce#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .

#################################################################
# Wind farm validation
#################################################################

dce:WindFarmShape
    a sh:NodeShape ;
    sh:targetClass dce:WindFarm ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path dce:exportCapacityMW ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:minExclusive 0 ;
    ] ;

    sh:property [
        sh:path dce:connectionDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
    ] ;

    sh:property [
        sh:path dce:locatedIn ;
        sh:minCount 1 ;
        sh:class dce:County ;
    ] ;

    sh:property [
        sh:path geo:hasGeometry ;
        sh:minCount 1 ;
        sh:class geo:Geometry ;
    ] .

#################################################################
# Electricity consumption validation
# MEC02 observations are national/sector-level and have no county;
# MEC03 observations are county-level. Therefore locatedIn is optional.
#################################################################

dce:ConsumptionShape
    a sh:NodeShape ;
    sh:targetClass dce:Consumption ;

    sh:property [
        sh:path dce:value ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:minInclusive 0 ;
    ] ;

    sh:property [
        sh:path dce:unit ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path dce:sector ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path dce:inPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class dce:Year ]
            [ sh:class dce:Quarter ]
        ) ;
    ] ;

    sh:property [
        sh:path dce:locatedIn ;
        sh:class dce:County ;
    ] .

#################################################################
# Electricity production validation
#################################################################

dce:ProductionShape
    a sh:NodeShape ;
    sh:targetClass dce:Production ;

    sh:property [
        sh:path dce:value ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:minInclusive 0 ;
    ] ;

    sh:property [
        sh:path dce:unit ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path dce:inPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class dce:Month ;
    ] ;

    sh:property [
        sh:path dce:hasFuelSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class dce:FuelSource ;
    ] .
