@prefix mce: <http://example.org/dce#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .

#################################################################
# Wind farm validation
#################################################################

mce:WindFarmShape
    a sh:NodeShape ;
    sh:targetClass mce:WindFarm ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path mce:exportCapacityMW ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:minExclusive 0 ;
    ] ;

    sh:property [
        sh:path mce:connectionDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
    ] ;

    sh:property [
        sh:path mce:locatedIn ;
        sh:minCount 1 ;
        sh:class mce:County ;
    ] ;

    sh:property [
        sh:path geo:hasGeometry ;
        sh:minCount 1 ;
        sh:class geo:Geometry ;
    ] .

#################################################################
# Electricity consumption validation
# MEC02 observations are national/sector-level and have no county;
# MEC03 observations are county-level. Therefore locatedIn is optional.
#################################################################

mce:ConsumptionShape
    a sh:NodeShape ;
    sh:targetClass mce:Consumption ;

    sh:property [
        sh:path mce:value ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:minInclusive 0 ;
    ] ;

    sh:property [
        sh:path mce:unit ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path mce:sector ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path mce:inPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class mce:Year ]
            [ sh:class mce:Quarter ]
        ) ;
    ] ;

    sh:property [
        sh:path mce:locatedIn ;
        sh:class mce:County ;
    ] .

#################################################################
# Electricity production validation
#################################################################

mce:ProductionShape
    a sh:NodeShape ;
    sh:targetClass mce:Production ;

    sh:property [
        sh:path mce:value ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:minInclusive 0 ;
    ] ;

    sh:property [
        sh:path mce:unit ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path mce:inPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class mce:Month ;
    ] ;

    sh:property [
        sh:path mce:hasFuelSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class mce:FuelSource ;
    ] .
