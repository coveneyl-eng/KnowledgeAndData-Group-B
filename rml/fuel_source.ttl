@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix dce:  <http://example.org/dce#> .
<#FuelSourceMap> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/clean_data/fuel_sources.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "http://example.org/dce#fuelSource/{fuel_id}" ;
    rr:class dce:FuelSource
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "fuel_name"
    ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate dce:renewable ;
    rr:objectMap [ rml:reference "renewable" ; rr:datatype xsd:boolean ]
  ].
