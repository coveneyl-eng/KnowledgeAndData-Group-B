@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix dce:  <http://example.org/dce#> .
<#ApplicationMap> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/clean_data/datacentre_applications_clean_pending_decisions.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "http://example.org/dce#application/{application_id}" ;
    rr:class dce:DataCentreApplication
  ] ;
  rr:predicateObjectMap [
    rr:predicate dce:locatedIn ;
    rr:objectMap [
      rr:template "http://example.org/dce#county/{county_id}" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "label"
    ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate dce:decisionDate ;
    rr:objectMap [ rml:reference "decision_date" ; rr:datatype xsd:date ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dce:applicationDate ;
    rr:objectMap [ rml:reference "application_date" ; rr:datatype xsd:date ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate dce:decisionStatus ;
    rr:objectMap [ rml:reference "decision_status" ]
  ];
    rr:predicateObjectMap [
    rr:predicate geo:hasGeometry ;
    rr:objectMap [
      rr:template "http://example.org/dce#application/{application_id}/geometry" ;
      rr:termType rr:IRI
    ]
  ].
  <#ApplicationGeometryMap> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/clean_data/datacentre_applications_clean_pending_decisions.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "http://example.org/dce#application/{application_id}/geometry" ;
    rr:class geo:Geometry
  ] ;
  rr:predicateObjectMap [
    rr:predicate geo:asWKT ;
    rr:objectMap [ rml:reference "wkt" ; rr:datatype geo:wktLiteral ]
  ] .

