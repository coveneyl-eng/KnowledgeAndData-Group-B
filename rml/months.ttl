@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix dce:  <http://example.org/dce#> .
<#MonthMap> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/clean_data/months.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "http://example.org/dce#month/{month_id}" ;
    rr:class dce:Month
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "month_id" ]
  ] ;
    rr:predicateObjectMap [
    rr:predicate dce:partOf ;
    rr:objectMap [ rr:template "http://example.org/dce#quarter/{quarter_id}" ]
  ] .
<#QuarterMap> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/clean_data/months.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "http://example.org/dce#quarter/{quarter_id}" ;
    rr:class dce:Quarter
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "quarter_id" ]
  ] .